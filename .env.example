# ── LLM routing (OpenRouter is the default provider) ──
# Either spelling of the key is accepted; presence of one selects OpenRouter.
OPEN_ROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Attribution shown in the OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=LNGUI Ecommerce Case Study

# ── Direct OpenAI instead of OpenRouter ──
# Used only when no OpenRouter key is set.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ── Observability (tracing is enabled only when both Langfuse keys are present) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── The system prompt P ──
# baseline: the prompt as recorded with Figure 1.2. Case invariance is violated
#           (UPPERCASE invents minRating=4) but multi-turn refinement leaks.
# extended: adds a preserve-context rule and the clearFilters field. Refinement
#           works and Cov_NL can reach 6/6, but the case-invariance violation
#           disappears. The two are separate experimental conditions; see
#           api/prompt.ts. CLEAR_ACTION_ENABLED is inert under baseline.
PROMPT_VARIANT=baseline
CLEAR_ACTION_ENABLED=true

# How much of H reaches the mediator. "none" seeds the display-only-history
# fault; "last-k" is truncation. Part of P.
HISTORY_POLICY=full
HISTORY_MAX_TURNS=3

# ── Local development ──
# Deterministic prompt parser; no network LLM call. Use this for UI and harness work.
LOCAL_TEST_MODE=false
