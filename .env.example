# Copy to .env. Only the keys below are read. Model, sampling, reasoning, history
# and prompt are not set here: the chat and every experiment configuration send
# them with each request, and a key a request leaves out is unset.

# OpenRouter, for every openrouter configuration and the chat.
OPEN_ROUTER_API_KEY=sk-or-v1-...

# Ollama on this machine, for ollama configurations. This is the default.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Langfuse tracing (optional; on only when both keys are set). Sweeps leave it off
# unless run with --langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
