# ── LLM routing (OpenRouter is the default provider) ──
# Either spelling of the key is accepted; presence of one selects OpenRouter.
OPEN_ROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Attribution shown in the OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=LNGUI Ecommerce Case Study

# ── Local models through Ollama ──
# Ollama serves an OpenAI-compatible API. Select it per condition with
# LLM_PROVIDER=ollama and LLM_MODEL=<model> (for example llama3.1:8b), or
# set them here to make the chat UI use a local model.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b

# ── Sampling ──
# Unset means "not sent": the provider's default for the model applies, and P
# records null. Figure 1.2 was recorded at temperature 0.
# LLM_TEMPERATURE=0
# LLM_TOP_P=1

# ── Direct OpenAI instead of OpenRouter ──
# Used only when no OpenRouter key is set.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ── Observability (tracing is enabled only when both Langfuse keys are present) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── The system prompt P ──
# The prompt is text. The default is prompts/default.txt (the prompt Figure 1.2
# was recorded with). Experiments pick prompt files per condition, so there is
# nothing to set here.

# How much of H reaches the mediator. "none" seeds the display-only-history
# fault; "last-k" is truncation. Part of P.
HISTORY_POLICY=full
HISTORY_MAX_TURNS=3

# ── Local development ──
# Deterministic prompt parser; no network LLM call. Use this for UI and harness work.
LOCAL_TEST_MODE=false

