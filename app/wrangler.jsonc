{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lngui-ecommerce",
  "main": "api/worker.ts",
  "compatibility_date": "2026-09-01",
  // The OpenAI SDK and the Langfuse SDK both expect some Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would swallow /api/* before the Worker
    // ever ran. Note this key nests inside "assets".
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lngui-turns",
      "database_id": "9a4c852e-9650-4182-88db-6e110fe70aba",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret runtime configuration. P is server-authoritative, so changing
  // these changes the experiment; secrets go through `wrangler secret put`.
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-4o-mini",
    // Deliberately false on the deployed instance: the URL is cited publicly in
    // the dissertation, and allow-any would let a stranger invoke an arbitrarily
    // expensive model on the account key. Local dev can still set it true.
    "OPENROUTER_MODEL_ALLOW_ANY": "false",
    "OPENROUTER_APP_TITLE": "LNGUI Ecommerce Case Study",
    // Temperature, top_p, reasoning, history policy and the prompt are not set
    // here: the chat and each experiment configuration send them with every
    // request (shared/models.ts holds each model's cited values).
    "LANGFUSE_BASE_URL": "https://us.cloud.langfuse.com",
    "LOCAL_TEST_MODE": "false"
  },

  "observability": { "enabled": true }
}
