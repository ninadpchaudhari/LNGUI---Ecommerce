# GPT-4o mini on OpenRouter, temperature 1, top_p 1, with app/prompts/explained.txt: the default prompt, plus what a
# left-out field and null do. Otherwise the same as gpt-4o-mini-default-t1-p1.
PORT=3107
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=1
LLM_TOP_P=1
HISTORY_POLICY=full
PROMPT=explained.txt
