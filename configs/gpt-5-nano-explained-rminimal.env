# GPT-5 nano on OpenRouter, reasoning minimal. Its sampling cannot be set, so the provider's defaults apply. With app/prompts/explained.txt.
# Otherwise the same as gpt-5-nano-default-rminimal.
PORT=3108
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-5-nano
LLM_REASONING_EFFORT=minimal
HISTORY_POLICY=full
PROMPT=explained.txt
