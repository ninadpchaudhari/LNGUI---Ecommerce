# Llama 3.2 3B Instruct on OpenRouter, temperature 0.6, top_p 0.9 (Meta's reference defaults for Llama 3 chat). With app/prompts/explained.txt.
# Otherwise the same as llama-3.2-3b-instruct-default-t0.6-p0.9.
PORT=3110
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.2-3b-instruct
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.9
HISTORY_POLICY=full
PROMPT=explained.txt
