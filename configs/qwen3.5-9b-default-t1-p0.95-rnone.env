# Qwen3.5 9B on OpenRouter, thinking off, temperature 1, top_p 0.95.
# (The model card's thinking-mode values; for thinking off it recommends 0.7 / 0.8.)
PORT=3105
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.5-9b
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_REASONING_EFFORT=none
HISTORY_POLICY=full
LLM_JSON_MODE=true
