# Qwen3.5 9B on OpenRouter, thinking off, temperature 0. No top_p is sent, so the provider's default applies. With app/prompts/explained.txt.
# Otherwise the same as qwen3.5-9b-default-t0-rnone.
PORT=3112
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.5-9b
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=none
HISTORY_POLICY=full
PROMPT=explained.txt
