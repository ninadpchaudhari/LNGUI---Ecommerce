{
  "name": "chat-assisted-ecommerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server.ts\"",
    "dev:docker": "concurrently \"vite --host 0.0.0.0 --port 5173\" \"tsx server.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx server.ts",
    "gen:surface": "tsx scripts/gen-surface.ts",
    "test": "tsx --test shared/*.test.ts api/*.test.ts",
    "build": "npm run gen:surface && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply lngui-turns --local",
    "d1:migrate": "wrangler d1 migrations apply lngui-turns --remote",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "langfuse": "^3.38.20",
    "openai": "^6.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "^4.142.0",
    "yaml": "^2.9.1"
  }
}
